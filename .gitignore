# ============================================================
# ZeroWaste F&B — .gitignore
# React(Node) + Python + PostgreSQL 스택 통합
# ============================================================

# --- 환경변수 / 민감정보 (제일 중요) ---
.env
.env.local
*.env
!.env.example

# --- Node.js / React (frontend) ---
node_modules/
frontend/build/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python (pipeline, seed) ---
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# --- 에디터 / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- 로그 / 임시파일 ---
*.log
*.tmp
